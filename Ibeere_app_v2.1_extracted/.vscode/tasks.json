{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Debug APK",
			"type": "shell",
			"command": "flutter",
			"args": [
				"build",
				"apk",
				"--debug"
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "Flutter Analyze",
			"type": "shell",
			"command": "flutter",
			"args": [
				"analyze"
			],
			"problemMatcher": [
				"$dart"
			],
			"group": "build"
		},
		{
			"label": "Flutter Analyze Clean",
			"type": "shell",
			"command": "flutter",
			"args": [
				"analyze",
				"--no-fatal-infos"
			],
			"problemMatcher": [
				"$dart"
			],
			"group": "build"
		},
		{
			"label": "Quick Analyze",
			"type": "shell",
			"command": "flutter",
			"args": [
				"analyze",
				"--no-fatal-infos"
			],
			"group": "build"
		},
		{
			"label": "Resolve Dependencies",
			"type": "shell",
			"command": "flutter",
			"args": [
				"pub",
				"get"
			]
		},
		{
			"label": "Flutter Analysis",
			"type": "shell",
			"command": "flutter",
			"args": [
				"analyze",
				"--no-fatal-infos"
			]
		},
		{
			"label": "Full Analyze",
			"type": "shell",
			"command": "flutter",
			"args": [
				"analyze"
			],
			"isBackground": false
		},
		{
			"label": "Flutter Build Web",
			"type": "shell",
			"command": "flutter",
			"args": [
				"build",
				"web"
			],
			"isBackground": false,
			"group": "build"
		}
	]
}